{
  "name": "nefertum-visage",
  "version": "0.1.0",
  "private": true,
  "description": "Web BFF for the Nefertum fragrance platform — Express + Nunjucks SSR + HTMX + Tailwind v4.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch apps/web-bff/src/main.ts",
    "build": "tsc && vite build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.19.0",
    "graphql-request": "^7.0.0",
    "helmet": "^7.0.0",
    "nunjucks": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/nunjucks": "^3.2.0",
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
