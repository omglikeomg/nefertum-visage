{# R24 — 5 bars wired for HTMX outerHTML swap. Bucket labels mirror
   SCALE_BUCKET_DEFINITIONS in nefertum-nest's scale-histogram.vo.ts so the UI
   vocabulary matches the domain. VALUE is included because the mock data
   carries a VALUE histogram for shape parity; without it the labels lookup
   resolves to an empty string and the bars render unlabelled. #}
{% macro render(histogram, perfumeId, metric) %}
  {% set labels = {
    "GENDER": ["Masc", "Lean M", "Bal", "Lean F", "Fem"],
    "LONGEVITY": ["Poor", "Weak", "Mod", "Long", "Beast"],
    "SILLAGE": ["Inti", "Soft", "Mod", "Strong", "Enor"],
    "VALUE": ["Over", "Fair", "Good", "V.Good", "Excep"]
  } %}
  <div id="histogram-{{ perfumeId }}-{{ metric }}" class="mb-4">
    <h4 class="text-sm font-semibold mb-2">{{ metric }}</h4>
    <div class="flex items-end h-32 gap-1">
      {% for bucket in [0, 1, 2, 3, 4] %}
        <button class="bg-blue-500 hover:bg-blue-700 text-white text-xs px-2 py-1"
                hx-post="/fragrance/{{ perfumeId }}/vote/{{ metric }}?bucket={{ bucket }}"
                hx-target="#histogram-{{ perfumeId }}-{{ metric }}"
                hx-swap="outerHTML"
                hx-indicator="#histogram-{{ perfumeId }}-{{ metric }}-spinner"
                style="height: {{ histogram.buckets[bucket] | percentage(histogram.totalVotes) }}%; min-height: 8px;">
          {{ labels[metric][bucket] }}<br>{{ histogram.buckets[bucket] }}
        </button>
      {% endfor %}
    </div>
    <p class="text-xs text-gray-400 mt-1">{{ histogram.totalVotes }} votes</p>
    <div id="histogram-{{ perfumeId }}-{{ metric }}-spinner" class="htmx-indicator">Loading…</div>
  </div>
{% endmacro %}
